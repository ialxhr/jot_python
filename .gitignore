# Виртуальные окружения Python (зависимости)
.venv/
venv/
env/
ENV/
pyvenv.cfg

# Кэш компиляции Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Секреты и настройки (переменные окружения)
.env
.env.*
!.env.example
.secrets
secrets/
config.local.*
settings.local.*

# Конфигурации редакторов кода
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Логи и результаты тестов
*.log
.pytest_cache/
.coverage
htmlcov/

# Резервные копии и временные файлы
*.bak
*.tmp
*.orig
*~

# Сборка и дистрибутивы Python
build/
dist/
*.egg-info/
